# Supabase (persistence). When these are set, the app reads/writes data in Supabase;
# image binaries stay on the local file system.
SUPABASE_URL=
# New publishable key (anon). Same var is used by the quickstart: SUPABASE_KEY.
SUPABASE_KEY=
# Classic anon key (fallback if SUPABASE_KEY is not set).
SUPABASE_ANON_KEY=
# Server secret (required for server-side writes and the migration script).
SUPABASE_SECRET_KEY=

# Local data dir for playground photos/scenes (unchanged from before).
# DATA_DIR=data/playgrounds
