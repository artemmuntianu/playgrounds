# Supabase (persistence). All playground metadata lives in Supabase.
SUPABASE_URL=
# New publishable key (anon). Same var is used by the quickstart: SUPABASE_KEY.
SUPABASE_KEY=
# Classic anon key (fallback if SUPABASE_KEY is not set).
SUPABASE_ANON_KEY=
# Server secret (required for server-side writes and the migration script).
SUPABASE_SECRET_KEY=

# Vercel Blob (image binaries: photos / depth maps / seg masks).
# Generated/attached automatically when you create a Blob store for the Vercel project.
BLOB_READ_WRITE_TOKEN=
