# .clineignore
# Patterns here tell Cline which files/folders to SKIP reading.
# Skipping generated, binary, and huge files keeps prompts lean and
# saves tokens when running LLM prompts against this codebase.
# Syntax follows .gitignore glob rules (Cline applies them to the tree).

# --- Version control internals ---
.git/
.gitignore
.clineignore

# --- Dependencies (huge, never edited by hand) ---
node_modules/

# --- Build / generated output (regenerated by `npm build`) ---
dist/
.astro/
.vercel/

# --- Local state, uploads and data dumps (binary / non-source) ---
uploads/
data/

# --- Large image assets / binaries (unreadable to the model as text) ---
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.avif
*.bin
*.map
*.ico
*.pdf

# --- Lockfiles & dependency manifests (verbose, auto-managed) ---
package-lock.json

# --- Logs & temp files ---
*.log
*.tmp
*.temp
.DS_Store
Thumbs.db

# --- Scratch / one-off scripts not part of source ---
test-additional-depth.mjs
